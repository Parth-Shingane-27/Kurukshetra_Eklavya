# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=asbo

# LLM Explanation Service (Google Gemini) — optional; template fallback is used if unset (BR-010)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Admin credential for Scheme KB management endpoints (legacy header; also usable as the
# one-time admin-account bootstrap secret for POST /api/auth/register, see plan.md Section 20)
ADMIN_CREDENTIAL=change-me-admin-token

# Load database/seed_schemes.json into MongoDB on backend startup (dev/demo mode)
SEED_SCHEMES_ON_STARTUP=true

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Two-step (email+password+OTP) authentication (FR-016)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Resend (https://resend.com) sends the OTP email. Leave blank to fall back to logging the
# code to the backend console (dev/demo mode) instead of sending real email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ASBO <onboarding@resend.dev>
