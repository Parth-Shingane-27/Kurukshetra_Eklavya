# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=asbo

# LLM Explanation Service (Google Gemini) — optional; template fallback is used if unset (BR-010)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Alternate free-tier LLM providers (not yet wired into the code — paste keys here now,
# integration comes next)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Admin credential for Scheme KB management endpoints (legacy header; also usable as the
# one-time admin-account bootstrap secret for POST /api/auth/register, see plan.md Section 20)
ADMIN_CREDENTIAL=change-me-admin-token

# Load database/seed_schemes.json into MongoDB on backend startup (dev/demo mode)
SEED_SCHEMES_ON_STARTUP=true

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Email+password authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Form Guide — YouTube tutorial video recommendation (server-side only; never exposed to the
# frontend). Leave blank to disable — the Form Guide itself works fully without it, "Watch
# Video" is simply unavailable.
YOUTUBE_API_KEY=

# Live web search (Tavily, https://tavily.com) — feeds the RAG refresh queue and the scheme
# discovery queue with real internet results instead of only the static local corpus. Leave
# blank to disable — both queues fall back to corpus-only behavior.
TAVILY_API_KEY=
