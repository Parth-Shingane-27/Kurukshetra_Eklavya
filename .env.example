# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=asbo

# LLM Explanation Service (Google Gemini) — optional; template fallback is used if unset (BR-010)
GEMINI_API_KEY=
# A rolling alias (not a dated snapshot) so this doesn't go stale as Google retires models.
GEMINI_MODEL=gemini-flash-latest

# Admin credential for Scheme KB management endpoints (prototype-grade auth, see plan.md Section 20)
ADMIN_CREDENTIAL=change-me-admin-token

# Load database/seed_schemes.json into MongoDB on backend startup (dev/demo mode)
SEED_SCHEMES_ON_STARTUP=true

# Comma-separated list of frontend origins allowed by CORS. Defaults cover the Vite dev
# server (5173) and its production preview (4173). A real hosted deployment should set
# this to that deployment's actual origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- RAG layer (Shared Policy Knowledge Service) ---
# Embeddings reuse GEMINI_API_KEY above — required for ingestion/retrieval, unlike the
# optional explanation LLM call (there is no RAG without embeddings).
EMBEDDING_MODEL=gemini-embedding-001
# Local Chroma persistence directory (relative to backend/), and the paired BM25 keyword
# index used for hybrid retrieval. Both are populated by `python backend/scripts/ingest_policies.py`.
CHROMA_PERSIST_DIR=./data/chroma
BM25_INDEX_PATH=./data/bm25_index.pkl
RAG_TOP_K=5
# Path (relative to backend/) to the cleaned scheme corpus that ingestion indexes.
POLICY_CORPUS_PATH=../gov_schemes_cleaned.json
