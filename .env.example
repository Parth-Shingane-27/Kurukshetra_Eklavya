# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=asbo

# LLM Explanation Service (Google Gemini) — optional; template fallback is used if unset (BR-010)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Admin credential for Scheme KB management endpoints (prototype-grade auth, see plan.md Section 20)
ADMIN_CREDENTIAL=change-me-admin-token

# Load database/seed_schemes.json into MongoDB on backend startup (dev/demo mode)
SEED_SCHEMES_ON_STARTUP=true

# Comma-separated list of frontend origins allowed by CORS. Defaults cover the Vite dev
# server (5173) and its production preview (4173). A real hosted deployment should set
# this to that deployment's actual origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
